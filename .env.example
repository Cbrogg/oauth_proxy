# Домены (публичные, резолвятся на хост в DNS для Let's Encrypt)
DOMAIN_FACADE=mcp-auth.example.com
DOMAIN_POCKETID=id.example.com
DOMAIN_LITELLM=litellm.example.com

# TLS / Let's Encrypt
ACME_EMAIL=admin@example.com

# Часовой пояс контейнеров (опционально)
TZ=UTC

# PostgreSQL (используется LiteLLM)
POSTGRES_USER=litellm
POSTGRES_PASSWORD=CHANGE_ME_STRONG
POSTGRES_DB=litellm

# LiteLLM (master key для админки/API, salt key для хеширования ключей)
LITELLM_MASTER_KEY=CHANGE_ME_MASTER_KEY
LITELLM_SALT_KEY=CHANGE_ME_SALT_KEY

# Pocket ID client_id, который ChatGPT использует при OAuth (создаётся в UI Pocket ID)
CHATGPT_POCKET_ID_CLIENT_ID=CHANGE_ME_CLIENT_ID

# Пользователь фасада и его Virtual Keys из LiteLLM (создаются в UI/API LiteLLM)
POCKET_ID_USER_SUB=CHANGE_ME_SUB
LITELLM_KEY_USER1_MEMOS=CHANGE_ME_VIRTUAL_KEY
LITELLM_KEY_USER1_N8N=CHANGE_ME_VIRTUAL_KEY